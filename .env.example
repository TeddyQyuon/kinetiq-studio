# ==============================================================================
# Kinetiq Studio — Environment Configuration (Phase 0 Laptop & Phase 1 VPS)
# ==============================================================================

# --- Runtime Environment ---
APP_ENV=phase0_local
RUN_EMBEDDED_ORCHESTRATOR=true

# --- Database ---
# Phase 0 Laptop Zero-Docker Default (SQLite WAL):
DATABASE_URL=sqlite:///./kinetiq.db
# Docker Compose / Phase 1 VPS PostgreSQL 16:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/kinetiq

# --- Redis (Optional in Phase 0, Recommended in Multi-Process / VPS) ---
REDIS_URL=

# --- Security & Encryption Secrets (CHANGE ALL THREE FOR PHASE 1 VPS!) ---
ENCRYPTION_MASTER_KEY=dev-only-32-byte-base64-key-change-before-prod
SESSION_SECRET=dev-only-session-secret-change-me
MEDIA_SIGNING_SECRET=dev-only-media-hmac-secret-change-me
MCP_ACCESS_TOKEN=

# --- Storage Vault ("local" for offline Phase 0, "drive" for Google Drive API v3) ---
STORAGE_PROVIDER=local
LOCAL_VAULT_DIR=./storage/vault

# --- Google OAuth 2.0 (drive.file + openid + email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# --- AI Brain Layer ---
# Primary: Gemini API (Google AI Pro credits in AI Studio)
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
# Optional BYOK: OpenAI Platform API (separate from ChatGPT Plus web)
OPENAI_API_KEY=

# --- Human-on-the-Loop (HOTL) Vision QA Defaults ---
QA_DEFAULT_POLICY=hotl_smart
QA_PASS_THRESHOLD=8.0
QA_MAX_RETRIES=2

# --- Worker Lease & Health Timing ---
JOB_LEASE_SECONDS=300
WORKER_OFFLINE_AFTER_SECONDS=60

# --- Public URLs & CORS ---
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
